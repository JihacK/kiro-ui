{
  "name": "kiro-ui",
  "version": "1.3.2",
  "description": "Desktop chat interface for Kiro CLI, connected via the Agent Client Protocol",
  "author": "Guyon IT Consulting <jerome.guyon@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cargo run -p kiro-ui-server\" \"vite\"",
    "build": "vite build",
    "start": "vite build && cargo run --release -p kiro-ui-server",
    "server:build": "vite build && cargo build --release -p kiro-ui-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --workspace",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run lint:rust && npm run test:rust",
    "desktop": "cargo run -p kiro-ui-desktop",
    "desktop:build": "cargo build --release -p kiro-ui-desktop",
    "desktop:install": "sh scripts/install-linux.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "marked": "15.0.12",
    "react": "^19.1.0",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
